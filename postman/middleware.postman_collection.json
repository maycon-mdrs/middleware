{
  "info": {
    "name": "Middleware TP2",
    "description": "Ops (ligar/desligar instancias) + checagens do gateway.\n\nPadrao local: opsBaseUrl=http://127.0.0.1:8081 e gatewayBaseUrl=http://127.0.0.1:8080\nNa EC2 (do PC): troque as variaveis pelo IP publico da instancia (SG com 8080/8081).\nNa demo, o mais estavel e SSH na VM e usar 127.0.0.1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "opsBaseUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "gatewayBaseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "item": [
    {
      "name": "Gateway",
      "item": [
        {
          "name": "GET /time/br",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/time/br"
          }
        },
        {
          "name": "GET /time/pt",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/time/pt"
          }
        },
        {
          "name": "GET /registry",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/registry"
          }
        },
        {
          "name": "GET /lookup",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/lookup"
          }
        }
      ]
    },
    {
      "name": "Ops — listar",
      "item": [
        {
          "name": "GET instances",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{opsBaseUrl}}/instances"
          }
        }
      ]
    },
    {
      "name": "Ops — ligar",
      "item": [
        {
          "name": "POST br-1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"br\",\n  \"id\": \"br-1\",\n  \"port\": 9101\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{opsBaseUrl}}/instances"
          }
        },
        {
