[Unit]
Description=Middleware TP2 (GatewayApp + InstanceApp + ops)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/middleware
Environment=JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto
Environment=HOME=/home/ec2-user
ExecStart=/home/ec2-user/middleware/scripts/start-all.sh
ExecStop=/home/ec2-user/middleware/scripts/stop-all.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
